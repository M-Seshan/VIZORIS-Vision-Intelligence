
{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://vizoris-backend.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://vizoris-backend.onrender.com/uploads/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://vizoris-backend.onrender.com/ws/:path*"
    }
  ]
}
